rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidInventoryItem(data, isUpdate) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.quantity is number && data.quantity >= 0 &&
             data.upperOfficeQty is number && data.upperOfficeQty >= 0 &&
             data.downOfficeQty is number && data.downOfficeQty >= 0 &&
             data.nagdeviOfficeQty is number && data.nagdeviOfficeQty >= 0 &&
             data.updatedAt == request.time &&
             (isUpdate ? data.createdAt == resource.data.createdAt : data.createdAt == request.time);
    }

    match /inventory/{itemId} {
      allow create: if isSignedIn() && isValidInventoryItem(request.resource.data, false);
      allow get, list: if isSignedIn();
      allow update: if isSignedIn() && isValidInventoryItem(request.resource.data, true);
      allow delete: if isSignedIn();
    }

    function isValidSaleRecord(data) {
      return data.itemId is string &&
             data.itemName is string &&
             data.customerName is string &&
             data.companyName is string &&
             data.quantity is number && data.quantity > 0 &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.location is string &&
             data.soldAt is timestamp &&
             data.notes is string;
    }

    match /sales/{saleId} {
      allow create: if isSignedIn() && isValidSaleRecord(request.resource.data);
      allow get, list: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    function isValidPurchaseRecord(data) {
      return data.itemId is string &&
             data.itemName is string &&
             data.supplierName is string &&
             data.quantity is number && data.quantity > 0 &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.location is string &&
             data.purchasedAt is timestamp &&
             data.notes is string;
    }

    match /purchases/{purchaseId} {
      allow create: if isSignedIn() && isValidPurchaseRecord(request.resource.data);
      allow get, list: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    function isValidAuditLog(data) {
      return data.action is string &&
             data.itemName is string && data.itemName.size() <= 200 &&
             data.timestamp == request.time &&
             data.performedBy is string &&
             data.performedByEmail is string;
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn() && isValidAuditLog(request.resource.data);
      allow list: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
